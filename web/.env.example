# ---------------------------------------------------------------------------
# Boomerang × ITCH-SOLVER ZERO — optional local configuration
#
# Copy this file to `.env` only if you plan to use the local proxy
# (`npm run proxy`). The app itself needs NO environment variables: your API
# key is typed into the UI and stored in your own browser's localStorage.
#
# Nothing in this repo ever contains a secret. Do not commit `.env`.
# ---------------------------------------------------------------------------

# Port the local CORS proxy listens on. Must match the "Proxy" route URL shown
# in the app's Settings dialog (default: http://localhost:8787/api/chat).
PORT=8787

# CORS origin allowed to call the proxy. Use your deployed site origin in
# production, e.g. https://boomerang.example.com. Defaults to "*" (fine for
# local development only).
PROXY_ORIGIN=*

# Optional shared secret. When set, the app must send it as `x-proxy-token`
# on every proxy request — fill the same value into the Settings dialog's
# "Proxy token" field. Leave empty to disable the check.
PROXY_TOKEN=
